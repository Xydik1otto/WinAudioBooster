<Application x:Class="WinAudioBooster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="/MainWindow/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Skins/ArchLinux.xaml"/>
                <ResourceDictionary Source="Resources/Strings.uk.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Hardware Studio Color Palette Overrides -->
            <SolidColorBrush x:Key="RazerBg" Color="#0D0E12"/>
            <SolidColorBrush x:Key="RazerCardBg" Color="#15171E"/>
            <SolidColorBrush x:Key="RazerCardHeaderBg" Color="#1E212B"/>
            <SolidColorBrush x:Key="RazerBorder" Color="#2A2E3D"/>
            <SolidColorBrush x:Key="RazerBorderActive" Color="#00FF66"/>
            <SolidColorBrush x:Key="RazerGreen" Color="#00FF66"/>
            <SolidColorBrush x:Key="RazerGreenHover" Color="#33FF85"/>
            <SolidColorBrush x:Key="RazerTextMain" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="RazerTextMuted" Color="#94A3B8"/>

            <!-- Custom ScrollViewer Style -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#334155" CornerRadius="3"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio Hardware Tactile Button Style -->
            <Style x:Key="RazerButton" TargetType="Button">
                <Setter Property="Background" Value="#1E212B"/>
                <Setter Property="Foreground" Value="{StaticResource RazerTextMain}"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.4"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2A2F3D"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource RazerGreen}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F1117"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio Hardware Primary Action Button -->
            <Style x:Key="RazerPrimaryButton" TargetType="Button" BasedOn="{StaticResource RazerButton}">
                <Setter Property="Background" Value="#064E3B"/>
                <Setter Property="Foreground" Value="{StaticResource RazerGreen}"/>
                <Setter Property="BorderBrush" Value="#059669"/>
            </Style>

            <!-- Studio Hardware CheckBox -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource RazerTextMain}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="checkBoxBorder" Width="20" Height="20" 
                                        Background="#0F1117" BorderBrush="#334155" 
                                        BorderThickness="2" CornerRadius="4" Margin="0,0,10,0">
                                    <Path x:Name="checkMark" Data="M 3,9 L 8,14 L 16,4" 
                                          Stroke="{StaticResource RazerGreen}" StrokeThickness="2.5" 
                                          Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{StaticResource RazerGreen}"/>
                                    <Setter TargetName="checkBoxBorder" Property="Background" Value="#064E3B"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{StaticResource RazerGreenHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio Hardware Mixing Fader / Slider Style -->
            <Style TargetType="Slider">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border x:Name="TrackBackground" Height="8" Background="#0B0D12" CornerRadius="4" BorderBrush="#2A2E3D" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.8" Direction="270"/>
                                    </Border.Effect>
                                </Border>
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Width="20" Height="24" Cursor="Hand">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#1E212B" BorderBrush="{StaticResource RazerGreen}" BorderThickness="1.5" CornerRadius="3">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00FF66" Opacity="0.5"/>
                                                        </Border.Effect>
                                                        <Rectangle Width="2" Height="12" Fill="{StaticResource RazerGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio Hardware ComboBox -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#1E212B"/>
                <Setter Property="Foreground" Value="{StaticResource RazerTextMain}"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" 
                                              Background="{TemplateBinding Background}" 
                                              BorderBrush="{TemplateBinding BorderBrush}" 
                                              BorderThickness="{TemplateBinding BorderThickness}" 
                                              Focusable="False" 
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{StaticResource RazerGreen}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border x:Name="DropDownBorder" Background="#15171E" BorderBrush="{StaticResource RazerGreen}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="220">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio Hardware Rack Unit (GroupBox) -->
            <Style TargetType="GroupBox">
                <Setter Property="Background" Value="{StaticResource RazerCardBg}"/>
                <Setter Property="BorderBrush" Value="#2A2E3D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource RazerTextMain}"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#000000" Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- Rack Panel Screw / Header Plate -->
                                    <Border Grid.Row="0" Background="{StaticResource RazerCardHeaderBg}" CornerRadius="6,6,0,0" Padding="14,10" BorderBrush="#2A2E3D" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Simulated Rack Screws -->
                                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{StaticResource RazerTextMain}" TextElement.FontWeight="Bold" TextElement.FontSize="13"/>
                                            <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#334155" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Studio LED ProgressBar Style -->
            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="#0B0D12"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="#2A2E3D" BorderThickness="1">
                                <Grid x:Name="TemplateRoot">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#00FF66" Opacity="0.6"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>