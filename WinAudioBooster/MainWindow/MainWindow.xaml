<Window x:Class="WinAudioBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinAudioBooster"
        xmlns:converters="clr-namespace:WinAudioBooster.Converters"
        Title="{DynamicResource MainWindow_Title}"
        Height="860"
        Width="620"
        Background="{DynamicResource RazerBg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:GainToColorConverter x:Key="GainToColorConverter"/>
        <converters:GainToWarningVisibilityConverter x:Key="GainToWarningVisibilityConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header & Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="24" Background="{DynamicResource RazerGreen}" CornerRadius="2" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00FF66" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="{DynamicResource AppTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource RazerTextMain}"/>
                    </StackPanel>

                    <!-- App Mixer Toggle Button -->
                    <Button Grid.Column="1" Content="🎛️ Мікшер програм" Click="ToggleAppMixer_OnClick" Style="{StaticResource RazerButton}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="InstallCableButton" Content="{DynamicResource InstallCable_Btn}" Click="InstallCableButton_OnClick" Style="{StaticResource RazerPrimaryButton}"/>
                    <Button Grid.Column="1" Content="🤖 Правила AI/Apps" Click="ToggleRulesEditor_OnClick" Style="{StaticResource RazerButton}" Margin="0,0,8,0"/>
                </Grid>

                <!-- Quick Routing Toggle Group -->
                <GroupBox Grid.Row="1" Header="{DynamicResource Routing_Group}" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="SetCableDefaultBtn" Content="{DynamicResource SetCableDefault_Btn}" Click="SetCableDefaultBtn_OnClick" Style="{StaticResource RazerButton}" Margin="0,0,4,0"/>
                        <Button Grid.Column="1" x:Name="SetSpeakersDefaultBtn" Content="{DynamicResource SetSpeakersDefault_Btn}" Click="SetSpeakersDefaultBtn_OnClick" Style="{StaticResource RazerButton}" Margin="4,0,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Main Booster Toggle Banner -->
                <Border Grid.Row="2" Background="{DynamicResource RazerCardBg}" BorderBrush="{DynamicResource RazerBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" 
                                  x:Name="EnableBoosterCheckBox"
                                  Content="{DynamicResource EnableBooster_Label}"
                                  FontSize="15"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  Click="EnableBoosterCheckBox_OnClick"/>

                        <TextBlock Grid.Column="1" 
                                   x:Name="BoosterStateText"
                                   Text="{DynamicResource BoosterState_Off}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource RazerTextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DSP Settings Panel -->
                <StackPanel Grid.Row="3" x:Name="DspSettingsPanel" IsEnabled="False">

                    <!-- Physical Output Device -->
                    <GroupBox Header="{DynamicResource OutputDevice_Group}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource OutputDevice_Label}" Foreground="{DynamicResource RazerTextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                            <ComboBox Grid.Column="1" x:Name="OutputDeviceComboBox" SelectionChanged="OutputDeviceComboBox_OnSelectionChanged" Height="28"/>
                        </Grid>
                    </GroupBox>

                    <!-- Presets Bar -->
                    <GroupBox Header="{DynamicResource Presets_Group}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" x:Name="PresetsComboBox" SelectionChanged="PresetsComboBox_OnSelectionChanged" Height="28" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" x:Name="SaveAsPresetButton" Content="{DynamicResource Preset_SaveAs}" Click="SaveAsPresetButton_OnClick" Style="{StaticResource RazerButton}" Margin="0,0,4,0"/>
                            <Button Grid.Column="2" x:Name="RenamePresetButton" Content="Перейменов." Click="RenamePresetButton_OnClick" Style="{StaticResource RazerButton}" Margin="0,0,4,0"/>
                            <Button Grid.Column="3" x:Name="UpdatePresetButton" Content="{DynamicResource Preset_Update}" Click="UpdatePresetButton_OnClick" Style="{StaticResource RazerButton}" Margin="0,0,4,0"/>
                            <Button Grid.Column="4" x:Name="DeletePresetButton" Content="{DynamicResource Preset_Delete}" Click="DeletePresetButton_OnClick" Style="{StaticResource RazerButton}" Foreground="#FF5555"/>
                        </Grid>
                    </GroupBox>

                    <!-- Volume / Gain Slider -->
                    <GroupBox Header="Загальна гучність (Volume)" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Рівень підсилення" Foreground="{DynamicResource RazerTextMain}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GainValueText" Text="100%" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{Binding Value, ElementName=GainSlider, Converter={StaticResource GainToColorConverter}}"/>
                            </Grid>
                            <Slider x:Name="GainSlider" Minimum="0" Maximum="300" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="GainSlider_OnValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- High Gain Warning -->
                    <Border Margin="0,0,0,12" Padding="10" Background="#2A1A00" BorderBrush="#FF9900" BorderThickness="1" CornerRadius="6" Visibility="{Binding Value, ElementName=GainSlider, Converter={StaticResource GainToWarningVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="13"/>
                            <TextBlock Text="{DynamicResource HighGainWarning_Text}" TextWrapping="Wrap" FontSize="11" Foreground="#FFCC66"/>
                        </StackPanel>
                    </Border>

                    <!-- Compressor -->
                    <GroupBox Header="{DynamicResource Compressor_Group}" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Threshold_Label}" Foreground="{DynamicResource RazerTextMuted}" FontSize="11"/>
                                <TextBlock x:Name="CompThresholdText" Foreground="{DynamicResource RazerTextMain}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="CompThresholdSlider" Minimum="-60" Maximum="0" Value="-20" ValueChanged="CompThresholdSlider_OnValueChanged" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Ratio_Label}" Foreground="{DynamicResource RazerTextMuted}" FontSize="11"/>
                                <TextBlock x:Name="CompRatioText" Foreground="{DynamicResource RazerTextMain}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="CompRatioSlider" Minimum="1" Maximum="20" Value="3" ValueChanged="CompRatioSlider_OnValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Limiter -->
                    <GroupBox Header="{DynamicResource Limiter_Group}" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Ceiling_Label}" Foreground="{DynamicResource RazerTextMuted}" FontSize="11"/>
                                <TextBlock x:Name="LimiterCeilingText" Foreground="{DynamicResource RazerTextMain}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="LimiterCeilingSlider" Minimum="-3" Maximum="0" Value="-0.3" TickFrequency="0.1" ValueChanged="LimiterCeilingSlider_OnValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Equalizer -->
                    <GroupBox Header="{DynamicResource Eq_Group}" Padding="10" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <CheckBox x:Name="EqEnabledCheckBox"
                                          Content="{DynamicResource Eq_Enable}"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"
                                          Checked="EqToggle_OnChecked"
                                          Unchecked="EqToggle_OnChecked"/>
                                <Button x:Name="ResetEqButton"
                                        Content="{DynamicResource Eq_Reset}"
                                        Click="ResetEqButton_OnClick"
                                        Style="{StaticResource RazerButton}"
                                        HorizontalAlignment="Right"
                                        Padding="10,3"/>
                            </Grid>

                            <!-- Швидкі DSP-тоггли: Bass Boost / Treble Boost / Cut sub-bass (30 Гц) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="BassBoostCheckBox"
                                          Content="{DynamicResource BassBoost_Label}"
                                          Tag="Bass" FontSize="12"
                                          HorizontalAlignment="Left"
                                          Checked="DspBoostToggle_OnChecked"
                                          Unchecked="DspBoostToggle_OnChecked"/>
                                <CheckBox Grid.Column="1" x:Name="TrebleBoostCheckBox"
                                          Content="{DynamicResource TrebleBoost_Label}"
                                          Tag="Treble" FontSize="12"
                                          HorizontalAlignment="Left" Margin="8,0"
                                          Checked="DspBoostToggle_OnChecked"
                                          Unchecked="DspBoostToggle_OnChecked"/>
                                <CheckBox Grid.Column="2" x:Name="SubBassFilterCheckBox"
                                          Content="{DynamicResource SubBassFilter_Label}"
                                          Tag="SubBass" FontSize="12"
                                          HorizontalAlignment="Left"
                                          Checked="DspBoostToggle_OnChecked"
                                          Unchecked="DspBoostToggle_OnChecked"/>
                            </Grid>

                            <!-- 10 вертикальних слайдерів: 31 Гц … 16 кГц -->
                            <UniformGrid Columns="10">
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider0" Tag="0" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="31" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText0" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider1" Tag="1" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="62" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText1" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider2" Tag="2" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="125" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText2" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider3" Tag="3" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="250" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText3" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider4" Tag="4" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="500" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText4" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider5" Tag="5" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="1k" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText5" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider6" Tag="6" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="2k" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText6" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider7" Tag="7" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="4k" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText7" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider8" Tag="8" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="8k" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText8" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="1,0">
                                    <Slider x:Name="EqSlider9" Tag="9" Orientation="Vertical" Height="120" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" TickPlacement="TopLeft" ValueChanged="EqSlider_OnValueChanged" HorizontalAlignment="Center"/>
                                    <TextBlock Text="16k" Foreground="{DynamicResource RazerTextMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EqDbText9" Text="0.0 dB" Foreground="{DynamicResource RazerTextMain}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- VU Meters -->
                <GroupBox Grid.Row="4" Header="{DynamicResource VuMeters_Group}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Vu_Input}" Foreground="{DynamicResource RazerTextMuted}" VerticalAlignment="Center" FontSize="11"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="InputVuBar" Height="8" Minimum="0" Maximum="1" Foreground="{DynamicResource RazerGreen}" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Vu_Output}" Foreground="{DynamicResource RazerTextMuted}" VerticalAlignment="Center" FontSize="11"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="OutputVuBar" Height="8" Minimum="0" Maximum="1" Foreground="#00BCFF" Margin="0,3"/>
                    </Grid>
                </GroupBox>

                <!-- System Settings: AutoStart, Hotkey & Language -->
                <GroupBox Grid.Row="5" Header="Системні налаштування" Padding="12" Margin="0,4,0,0">
                    <StackPanel>
                        <!-- AutoStart CheckBox -->
                        <CheckBox x:Name="AutoStartCheckBox" 
                                  Content="{DynamicResource AutoStart_Label}" 
                                  Click="AutoStartCheckBox_OnClick" 
                                  Margin="0,0,0,10"/>

                        <!-- Hotkey Setting Row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Глобальна клавіша бустера" Foreground="{DynamicResource RazerTextMuted}" FontSize="11"/>
                                <TextBlock x:Name="HotkeyDisplayText" Text="Ctrl + Alt + B" Foreground="{DynamicResource RazerTextMain}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ChangeHotkeyButton" Content="Змінити" Click="ChangeHotkeyButton_OnClick" Style="{StaticResource RazerButton}" Padding="8,4" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Додаткові фіксовані глобальні хоткеї (довідково) -->
                        <TextBlock Text="{DynamicResource Hotkeys_ExtraInfo}"
                                   Foreground="{DynamicResource RazerTextMuted}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Таймер сну -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SleepTimer_Label}" Foreground="{DynamicResource RazerTextMuted}" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1" x:Name="SleepTimerComboBox" SelectionChanged="SleepTimerComboBox_OnSelectionChanged" Width="120" Height="26">
                                <ComboBoxItem Content="{DynamicResource SleepTimer_Off}" Tag="0"/>
                                <ComboBoxItem Content="{DynamicResource SleepTimer_15Min}" Tag="15"/>
                                <ComboBoxItem Content="{DynamicResource SleepTimer_30Min}" Tag="30"/>
                                <ComboBoxItem Content="{DynamicResource SleepTimer_60Min}" Tag="60"/>
                            </ComboBox>
                        </Grid>

                        <!-- Theme Selection Row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Тема оформлення" Foreground="{DynamicResource RazerTextMuted}" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_OnSelectionChanged" HorizontalAlignment="Left" Width="160" Height="26">
                                <ComboBoxItem Content="{DynamicResource Theme_Auto}" Tag="Auto (Windows)"/>
                                <ComboBoxItem Content="Studio Hardware"/>
                                <ComboBoxItem Content="Arch Linux"/>
                                <ComboBoxItem Content="Windows XP"/>
                                <ComboBoxItem Content="Windows 11"/>
                            </ComboBox>
                        </Grid>

                        <!-- Language Switch -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{DynamicResource Language_Label}" Foreground="{DynamicResource RazerTextMuted}" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_OnSelectionChanged" HorizontalAlignment="Left" Width="140" Height="26">
                                <ComboBoxItem Content="{DynamicResource Language_Ukrainian}" Tag="uk-UA"/>
                                <ComboBoxItem Content="{DynamicResource Language_English}" Tag="en-US"/>
                            </ComboBox>
                        </Grid>
                        
                        <!-- Захист слуху: попередження при підсиленні >150% -->
                        <CheckBox x:Name="HearingProtectionCheckBox"
                                  Content="{DynamicResource HearingProtection_Label}"
                                  Click="HearingProtectionCheckBox_OnClick"
                                  Margin="0,0,0,10"/>

                        <!-- Профілі пристроїв: прив'язки «пристрій виводу → пресет» -->
                        <GroupBox Header="{DynamicResource DeviceProfiles_Group}" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" x:Name="ProfilesDeviceComboBox" Height="26" Margin="0,0,4,0" ToolTip="{DynamicResource DeviceProfiles_Device}"/>
                                    <ComboBox Grid.Column="1" x:Name="ProfilesPresetComboBox" Height="26" Margin="4,0" ToolTip="{DynamicResource DeviceProfiles_Preset}"/>
                                    <Button Grid.Column="2" Content="{DynamicResource DeviceProfiles_Add}" Click="AddDeviceProfile_OnClick" Style="{StaticResource RazerPrimaryButton}" Padding="10,4" Margin="4,0,0,0"/>
                                </Grid>

                                <ItemsControl x:Name="DeviceProfilesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1A22" BorderBrush="{DynamicResource RazerBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,4" Padding="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding DeviceName}" Foreground="{DynamicResource RazerTextMain}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource RazerTextMuted}" VerticalAlignment="Center" Margin="6,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PresetName}" Foreground="{DynamicResource RazerGreen}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="3" Content="✕" Tag="{Binding DeviceId}" Click="DeleteDeviceProfile_OnClick" Style="{StaticResource RazerButton}" Foreground="#FF5555" Padding="6,2" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <!-- Update Check Button -->
                        <Button x:Name="CheckUpdatesButton" Content="Перевірити оновлення" Click="CheckUpdatesButton_OnClick" Style="{StaticResource RazerButton}" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- Animated Per-App Mixer Overlay Panel -->
        <Border x:Name="AppMixerOverlay" Background="#F00B0B0E" Visibility="Collapsed" Opacity="0">
            <Border Background="{DynamicResource RazerCardBg}" BorderBrush="{DynamicResource RazerGreen}" BorderThickness="1.5" CornerRadius="12" Margin="30" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00FF66" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="🎛️ Мікшер гучності програм (з Boost до 300%)" Foreground="{DynamicResource RazerTextMain}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕ Закрити" Click="CloseAppMixer_OnClick" Style="{StaticResource RazerButton}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AppMixerItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A22" BorderBrush="{DynamicResource RazerBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Foreground="{DynamicResource RazerTextMain}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <Slider Grid.Column="1" Minimum="0" Maximum="300" Value="{Binding VolumePercent, Mode=TwoWay}" Tag="{Binding ProcessId}" ValueChanged="AppVolumeSlider_OnValueChanged" VerticalAlignment="Center" Margin="12,0"/>

                                            <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" Foreground="{DynamicResource RazerGreen}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="🔄 Оновити список процесів" Click="RefreshAppSessions_OnClick" Style="{StaticResource RazerPrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Border>
        <!-- Animated AppDetector Rules Editor Overlay -->
        <Border x:Name="RulesEditorOverlay" Background="#F00B0B0E" Visibility="Collapsed" Opacity="0">
            <Border Background="{DynamicResource RazerCardBg}" BorderBrush="{DynamicResource RazerGreen}" BorderThickness="1.5" CornerRadius="12" Margin="20" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00FF66" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🤖 Редактор правил автовизначення програм" Foreground="{DynamicResource RazerTextMain}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕ Закрити" Click="CloseRulesEditor_OnClick" Style="{StaticResource RazerButton}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Add Rule Form -->
                    <GroupBox Grid.Row="1" Header="Додати або змінити правило для програми" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Process ComboBox (Select running or type custom) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Програма / Процес:" Foreground="{DynamicResource RazerTextMuted}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="ActiveProcessesComboBox" 
                                      IsEditable="True" 
                                      Height="28" 
                                      Margin="0,0,8,0"
                                      Background="#1A1A22" 
                                      Foreground="{DynamicResource RazerTextMain}" 
                                      BorderBrush="{DynamicResource RazerBorder}">
                                <ComboBox.Resources>
                                    <!-- Фіксуємо колір тексту для внутрішнього поля введення (TextBox) -->
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RazerTextMain}"/>
                                        <Setter Property="CaretBrush" Value="{DynamicResource RazerGreen}"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#1A1A22"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RazerTextMain}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            
                            <!-- Preset ComboBox -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Авто-пресет:" Foreground="{DynamicResource RazerTextMuted}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="NewRulePresetCombo" Width="140" Height="28" Margin="0,0,0,0"/>

                            <!-- Volume Slider for Rule -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Індивідуальний рівень гучності (Boost):" Foreground="{DynamicResource RazerTextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="RuleVolumeText" Text="100%" Foreground="{DynamicResource RazerGreen}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" x:Name="RuleVolumeSlider" Minimum="0" Maximum="300" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="RuleVolumeSlider_OnValueChanged" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="Зберегти правило" Click="AddCustomRule_OnClick" Style="{StaticResource RazerPrimaryButton}" Height="28" Padding="12,4"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Rules List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RulesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A22" BorderBrush="{DynamicResource RazerBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Foreground="{DynamicResource RazerTextMain}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TargetPresetName}" Foreground="{DynamicResource RazerGreen}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:F0}%}" Foreground="#00BCFF" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="Видалити" Tag="{Binding ProcessName}" Click="DeleteRule_OnClick" Style="{StaticResource RazerButton}" Foreground="#FF5555" Padding="8,2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Description Footer (Fixed clipping with TextWrapping) -->
                    <TextBlock Grid.Row="3" Text="Принцип роботи: при запуску програми автоматично застосовується вказана гучність (до 300%) та пресет." 
                               Foreground="{DynamicResource RazerTextMuted}" 
                               FontSize="11" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>