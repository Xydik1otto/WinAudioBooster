<Window x:Class="WinAudioBooster.MiniMixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinAudioBooster Mini"
        Height="220"
        Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#313244" BorderThickness="1.5" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Drag Zone -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="WinAudioBooster" Foreground="#CDD6F4" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Click="CloseButton_OnClick" Content="✕" Foreground="#A6ADC8" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand"/>
            </Grid>

            <!-- Volume Slider (%) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Гучність" Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MiniGainText" Text="100%" Foreground="#89B4FA" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="MiniGainSlider" Minimum="0" Maximum="300" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="MiniGainSlider_OnValueChanged"/>
            </StackPanel>

            <!-- VU Meters -->
            <Grid Grid.Row="2" Margin="0,8,0,8">
                <ProgressBar x:Name="MiniVuBar" Height="6" Minimum="0" Maximum="1" Foreground="#A6E3A1" Background="#313244" BorderThickness="0"/>
            </Grid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="MiniBoosterToggle" Content="Booster" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Click="MiniBoosterToggle_OnClick"/>
                    <CheckBox x:Name="MiniEqToggle" Content="EQ" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Click="MiniEqToggle_OnClick"/>
                </StackPanel>
                <Button Grid.Column="1" Click="ExpandButton_OnClick" Content="⚙ Налаштування" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>